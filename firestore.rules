rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // Users can read/write their own profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Companies: owner or members can access
    match /companies/{companyId} {
      allow read, write: if isAuth() &&
        (resource == null || resource.data.ownerId == request.auth.uid);
    }

    // Inventory: scoped per user
    match /inventory/{userId}/items/{itemId} {
      allow read, write: if isOwner(userId);
    }

    // Inventory movements: scoped per user
    match /inventoryMovements/{userId}/records/{movId} {
      allow read, write: if isOwner(userId);
    }

    // Sales: scoped per user
    match /sales/{userId}/records/{saleId} {
      allow read, write: if isOwner(userId);
    }

    // Purchase orders: scoped per user
    match /purchaseOrders/{userId}/orders/{orderId} {
      allow read, write: if isOwner(userId);
    }

    // Feedback: users can write their own; reads only via admin SDK
    match /feedback/{userId}/reports/{reportId} {
      allow create: if isOwner(userId);
      allow read, delete: if false; // admin reads via server SDK only
    }

    // Customers: scoped per user
    match /customers/{userId}/records/{recordId} {
      allow read, write: if isOwner(userId);
    }

    // Suppliers: scoped per user
    match /users/{userId}/suppliers/{supplierId} {
      allow read, write: if isOwner(userId);
    }

    // Routes: scoped per user
    match /users/{userId}/routes/{routeId} {
      allow read, write: if isOwner(userId);
    }

    // Audit log: user can write, read only own
    match /auditLog/{userId}/events/{eventId} {
      allow read, write: if isOwner(userId);
    }
  }
}
