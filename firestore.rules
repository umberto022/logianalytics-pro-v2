rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // Caller's own profile doc — used to look up role/workspaceId for RBAC checks below.
    function callerProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function callerWorkspaceId() {
      return callerProfile().workspaceId;
    }

    function callerRole() {
      return callerProfile().role;
    }

    // Workspace status lives ONLY on the doc of the Admin who owns that workspace
    // (users/{workspaceId}, where workspaceId == that admin's own uid — same doc
    // callerProfile() already reads when the caller IS that admin, so this adds
    // zero extra get() calls for admins and exactly one for their employees).
    // Missing field = "active" — grandfathers every workspace created before this
    // status system existed (their docs never got the field backfilled).
    function workspaceIsActive(workspaceId) {
      let ws = get(/databases/$(database)/documents/users/$(workspaceId)).data;
      return !('workspaceStatus' in ws) || ws.workspaceStatus == 'active';
    }

    // True if the caller belongs to the given workspace (company) AND that
    // workspace hasn't been suspended/cancelled/isn't still pending approval.
    function inWorkspace(workspaceId) {
      return isAuth() && callerWorkspaceId() == workspaceId && workspaceIsActive(workspaceId);
    }

    // True if the caller belongs to the workspace AND their department is in `roles`.
    function roleIn(workspaceId, roles) {
      return inWorkspace(workspaceId) && callerRole() in roles;
    }

    // Users can read only their own profile. Writes are locked down to prevent
    // self-granting of role/workspaceId/platformAdmin — those are only ever set
    // via the Admin SDK (server-side API routes), which bypasses these rules.
    match /users/{userId} {
      allow read: if isOwner(userId);

      // Self-registration: you may only ever create yourself as the admin of
      // your own brand-new workspace (workspaceId == your own uid). If you send
      // a workspaceStatus at all, it can only be 'pending' — otherwise anyone
      // could self-activate at signup by just setting workspaceStatus: 'active'
      // in the same write, completely bypassing the approval step.
      allow create: if isOwner(userId) &&
        request.resource.data.role == 'admin' &&
        request.resource.data.workspaceId == userId &&
        !('platformAdmin' in request.resource.data) &&
        (!('workspaceStatus' in request.resource.data) || request.resource.data.workspaceStatus == 'pending');

      // Ongoing profile edits: safe personal fields only. `workspaceId` may be
      // set exactly once, as a self-heal, and only to your own uid. `fcmTokens` is the
      // FCM push registration list — client only ever arrayUnion/arrayRemove's its own
      // device token here; the server prunes dead tokens separately via the Admin SDK,
      // which bypasses these rules entirely.
      allow update: if isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['fullName', 'phone', 'photoURL', 'companyId', 'companyName', 'onboardingCompleted', 'lastLogin', 'workspaceId', 'fcmTokens']) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['workspaceId']) ||
          (!('workspaceId' in resource.data) && request.resource.data.workspaceId == userId));
    }

    // Companies: profile metadata doc (name, RIF, address...), doc id is an
    // auto-generated Firestore id (not a uid), unrelated to workspace data scoping.
    // Only the company's own admin may read/write their company profile doc.
    match /companies/{companyId} {
      allow read, write: if isAuth() && callerRole() == 'admin' &&
        (resource == null || resource.data.ownerId == request.auth.uid);
    }

    // Inventory: Logística crea/edita; Ventas reads (to know what's sellable);
    // Compras reads (to look up products/stock while building purchase orders).
    // Eliminar queda solo para Admin — coincide con el AdminButton de
    // inventario/page.tsx; separado de create/update porque el keyword `write`
    // de Firestore Rules cubre create+update+delete juntos, y sin este split
    // Logística podría borrar un producto llamando al SDK directo, saltándose
    // el botón deshabilitado en la UI.
    match /inventory/{workspaceId}/items/{itemId} {
      allow read: if roleIn(workspaceId, ['admin', 'logistica', 'ventas', 'compras']);
      allow create, update: if roleIn(workspaceId, ['admin', 'logistica']);
      allow delete: if roleIn(workspaceId, ['admin']);
    }

    match /inventoryMovements/{workspaceId}/records/{movId} {
      allow read: if roleIn(workspaceId, ['admin', 'logistica', 'ventas']);
      allow write: if roleIn(workspaceId, ['admin', 'logistica']);
    }

    // Sales: Ventas only.
    match /sales/{workspaceId}/records/{saleId} {
      allow read, write: if roleIn(workspaceId, ['admin', 'ventas']);
    }

    // Purchase orders: Compras creates/manages, Logística receives — both can
    // create/update; the finer-grained "who does what" split is enforced in the
    // UI, not here. Eliminar queda solo para Admin (ver nota de Inventory arriba
    // sobre por qué delete va separado) — coincide con el AdminButton de compras/page.tsx.
    match /purchaseOrders/{workspaceId}/orders/{orderId} {
      allow read: if roleIn(workspaceId, ['admin', 'compras', 'logistica']);
      allow create, update: if roleIn(workspaceId, ['admin', 'compras', 'logistica']);
      allow delete: if roleIn(workspaceId, ['admin']);
    }

    // Feedback: personal beta feedback, not workspace-scoped. Reads only via admin SDK.
    match /feedback/{userId}/reports/{reportId} {
      allow create: if isOwner(userId);
      allow read, delete: if false;
    }

    // Customers: Ventas crea/edita. Eliminar queda solo para Admin (ver nota de
    // Inventory arriba) — coincide con el AdminButton de clientes/page.tsx.
    match /customers/{workspaceId}/records/{recordId} {
      allow read: if roleIn(workspaceId, ['admin', 'ventas']);
      allow create, update: if roleIn(workspaceId, ['admin', 'ventas']);
      allow delete: if roleIn(workspaceId, ['admin']);
    }

    // Suppliers: Compras crea/edita; Logística/Ventas read (populates the supplier
    // dropdown on the Inventario product form, which they can also reach).
    // Eliminar queda solo para Admin (ver nota de Inventory arriba) — coincide
    // con el AdminButton de proveedores/page.tsx.
    match /users/{workspaceId}/suppliers/{supplierId} {
      allow read: if roleIn(workspaceId, ['admin', 'compras', 'logistica', 'ventas']);
      allow create, update: if roleIn(workspaceId, ['admin', 'compras']);
      allow delete: if roleIn(workspaceId, ['admin']);
    }

    // Routes: Logística only.
    match /users/{workspaceId}/routes/{routeId} {
      allow read, write: if roleIn(workspaceId, ['admin', 'logistica']);
    }

    // Insumos (materia prima) + su historial de movimientos + registros de
    // producción: solo Admin, a pedido explícito del usuario (dueña gestiona
    // costos reales de fabricación, ningún empleado toca esto).
    match /users/{workspaceId}/rawMaterials/{rawMaterialId} {
      allow read, write: if roleIn(workspaceId, ['admin']);
    }

    match /users/{workspaceId}/rawMaterialMovements/{movementId} {
      allow read, write: if roleIn(workspaceId, ['admin']);
    }

    match /users/{workspaceId}/productionRecords/{recordId} {
      allow read, write: if roleIn(workspaceId, ['admin']);
    }

    // Audit log: any workspace member can log their own actions; only Admin reads.
    match /auditLog/{workspaceId}/events/{eventId} {
      allow read: if roleIn(workspaceId, ['admin']);
      allow write: if inWorkspace(workspaceId);
    }

    // Caja sessions: Ventas only.
    match /caja/{workspaceId}/sessions/{sessionId} {
      allow read, write: if roleIn(workspaceId, ['admin', 'ventas']);
    }

    // Conteos físicos: lives inside the Inventario page (Logística), not Caja.
    match /conteos/{workspaceId}/records/{conteoId} {
      allow read, write: if roleIn(workspaceId, ['admin', 'logistica']);
    }

    // e-CF (facturación electrónica DGII): Ventas emite, Admin gestiona.
    // El envío real a Alanube pasa por /api/einvoicing (Admin SDK, API key
    // secreta) — estas reglas solo protegen el registro/estado guardado acá.
    match /electronicInvoices/{workspaceId}/records/{invoiceId} {
      allow read, write: if roleIn(workspaceId, ['admin', 'ventas']);
    }
  }
}
