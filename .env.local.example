# Firebase — copia como .env.local y rellena con tus credenciales
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cloudinary — https://cloudinary.com
# Subida FIRMADA (ver src/app/api/cloudinary-signature/route.ts) — reemplaza el
# viejo "unsigned upload preset" (cloud name + preset público en el bundle
# permitía subir archivos arbitrarios sin pasar por auth de la app).
# CLOUDINARY_API_KEY y CLOUDINARY_API_SECRET: Cloudinary Console → Settings →
# Security. El API_SECRET es server-only, NUNCA con prefijo NEXT_PUBLIC_.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe Payment Links — https://dashboard.stripe.com
# 1. Crea una cuenta en stripe.com
# 2. Ve a Products > Payment Links > Create link
# 3. Configura: LogiAnalytics Pro - $19/mes (recurring)
# 4. En "After payment", pon la URL de éxito:
#    https://logianalytics-pro-v2.vercel.app/configuracion?upgrade=success
# 5. Copia el Payment Link URL completo (ej: https://buy.stripe.com/xxx)
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=https://buy.stripe.com/xxx

# Alanube — facturación electrónica DGII (e-CF) — https://developer.alanube.co/
# Server-only, NUNCA con prefijo NEXT_PUBLIC_ (es la API key del facilitador).
# 1. Creá cuenta en alanube.co, pedí credenciales de sandbox.
# 2. Cargá el certificado digital de la empresa en su portal (createCompany).
# 3. ALANUBE_ENV=sandbox mientras probás; cambiá a production recién cuando
#    DGII certifique el ambiente de pruebas.
ALANUBE_API_KEY=
ALANUBE_ENV=sandbox

# WhatsApp Cloud API (Meta) — aviso automático de nuevas solicitudes del
# catálogo. Todas server-only, NUNCA con prefijo NEXT_PUBLIC_. Ver
# WHATSAPP_SETUP.md para el paso a paso completo en Meta Business Manager.
# El NÚMERO EMISOR (WHATSAPP_PHONE_NUMBER_ID) es siempre uno dedicado de la
# cuenta de Meta de LogiAnalytics — nunca el WhatsApp personal de una empresa
# cliente. El número RECEPTOR (a quién le llega el aviso) es
# CatalogSettings.whatsappNumber, configurado por cada empresa en "Mi catálogo".
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# App Secret de la app de Meta — para verificar la firma de los webhooks entrantes.
WHATSAPP_APP_SECRET=
# String propio (inventalo vos, ej. un UUID) — se configura igual en el
# webhook del App Dashboard de Meta para el handshake de verificación.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Nombre exacto y language code de la plantilla aprobada por Meta (ver WHATSAPP_SETUP.md).
WHATSAPP_TEMPLATE_NAME=nueva_solicitud_cotizacion
WHATSAPP_TEMPLATE_LANG=es
# Versión de la Graph API — configurable para no depender de un deploy si Meta retira una versión.
WHATSAPP_API_VERSION=v23.0
# Base URL de la app, para armar el enlace autenticado del aviso (por defecto
# ya apunta a producción — solo hace falta tocarlo en un entorno de staging).
APP_BASE_URL=https://logianalytics-pro-v2.vercel.app
# Interruptor del envío externo: SOLO el valor exacto "true" envía. Cargar credenciales no envía nada
# mientras esto esté vacío/ausente. Activar junto con WHATSAPP_SEND_NOT_BEFORE (ISO 8601, ej.
# 2026-10-05T14:00:00Z): los avisos creados antes de esa hora nunca se envían solos.
WHATSAPP_SENDING_ENABLED=
WHATSAPP_SEND_NOT_BEFORE=
# Edad máxima (minutos) para enviar un aviso sin intervención humana; pasada, queda "expired". Default 360.
WHATSAPP_JOB_MAX_AGE_MINUTES=
# Autoriza al cron diario de Vercel para llamar al worker (Bearer). >=16 caracteres aleatorios.
# Sin esto el worker rechaza todo (falla cerrado). Lo usa también el reporte mensual.
CRON_SECRET=
# Opcional — cola de despertadores QStash (ver WHATSAPP_SETUP.md §6). Se cargan solo en Vercel.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
